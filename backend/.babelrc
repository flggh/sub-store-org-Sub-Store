{
    "presets": [
        [
            "@babel/preset-env"
        ]
    ],
    "env": {
        "test": {
            "presets": [
                "@babel/preset-env"
            ]
        }
    },
    "plugins": [
        [
            "module-resolver",
            {
                "alias": {
                    "@": "./src"
                }
            }
        ]
    ]
}
